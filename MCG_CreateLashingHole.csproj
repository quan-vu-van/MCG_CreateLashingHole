<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>

    <!-- ============================================================
         .NET 8 (net8.0-windows) — BẮT BUỘC cho AutoCAD 2026.
         API managed AutoCAD 2026 (acmgd/acdbmgd/accoremgd) = .NETCoreApp v8.0;
         plugin net48 KHÔNG NETLOAD được. Bản .NET 8 chỉ chạy AutoCAD 2025+.
         ============================================================ -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>SDS</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MSBuildWarningsAsMessages>MSB3061</MSBuildWarningsAsMessages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>

    <!-- Sinh .deps.json + copy dependency ra output (AutoCAD 2025+ nạp plugin
         trong AssemblyLoadContext riêng). -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RollForward>LatestMinor</RollForward>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <!-- Plugin AutoCAD luôn chạy Windows — tắt cảnh báo platform-compat. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Cách ly design-time build của IDE (VS Code C# ext) khỏi obj/ thật.
       VS Code định kỳ chạy build ngầm để phục vụ IntelliSense (đặt $(DesignTimeBuild)=true).
       Build ngầm này CŨNG ghi vào obj\...\UI\LashingHolePalette.g.cs (đường dẫn KHÔNG có
       timestamp, không giống DLL output). Nếu nó chạy xen giữa lúc build thật (dotnet build
       task) đang MarkupCompile và Compile, file .g.cs bị ghi đè bởi AssemblyName của build
       ngầm → DLL cuối cùng và URI nhúng trong .g.cs LỆCH NHAU → lỗi NETLOAD
       "Could not load file or assembly '...timestamp khác'". Tách hẳn thư mục obj cho
       design-time build để không bao giờ đụng file với build thật. -->
  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true' or '$(BuildingProject)' == 'false'">
    <BaseIntermediateOutputPath>$(BaseIntermediateOutputPath)DesignTimeBuild\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Belt-and-suspenders cho isolation ở trên: nếu design-time build nào đó vẫn ghi
       DesignTimeBuild\ ra gốc project (thay vì dưới obj\), thư mục này KHÔNG bao giờ được
       glob vào Compile/Page mặc định của build thật, tránh lỗi trùng định nghĩa. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);DesignTimeBuild\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Debug: timestamp để tránh lock DLL khi AutoCAD đang mở.
       ⚠️ WPF quirk: build sinh một sub-build tạm "*_wpftmp" để biên dịch XAML,
       sub-build này evaluate LẠI project → $([System.DateTime]::Now) ra giây khác.
       Hậu quả: DLL được đặt tên theo evaluation build chính (vd ..._054101), còn
       URI assembly nhúng trong BAML/.g.cs lại theo evaluation _wpftmp (vd ..._054102)
       → runtime khi load palette báo "Could not load assembly ..._<giây khác>".
       Vá: sinh timestamp MỘT LẦN ở build chính rồi ghi ra file tạm; sub-build _wpftmp
       đọc lại đúng giá trị đó → tên DLL và URI trong BAML luôn khớp. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <_IsWpfTempBuild>false</_IsWpfTempBuild>
    <_IsWpfTempBuild Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">true</_IsWpfTempBuild>
    <_BuildStampFile>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'MCG_LashingHole.buildstamp'))</_BuildStampFile>

    <!-- Sub-build _wpftmp: DÙNG LẠI timestamp mà build chính đã ghi (đảm bảo khớp) -->
    <BuildTimestamp Condition="'$(_IsWpfTempBuild)' == 'true' and Exists('$(_BuildStampFile)')">$([System.IO.File]::ReadAllText('$(_BuildStampFile)').Trim())</BuildTimestamp>
    <!-- Build chính (hoặc fallback nếu file chưa có): sinh timestamp mới -->
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</BuildTimestamp>

    <AssemblyName>MCG_LashingHole_$(BuildTimestamp)</AssemblyName>
  </PropertyGroup>

  <!-- Ghi timestamp của build CHÍNH ra file tạm TRƯỚC khi WPF spawn sub-build _wpftmp -->
  <Target Name="WriteBuildStamp"
          Condition="'$(Configuration)' == 'Debug' and '$(_IsWpfTempBuild)' != 'true'"
          BeforeTargets="BeforeBuild;MarkupCompilePass1;GenerateTemporaryTargetAssembly">
    <WriteLinesToFile File="$(_BuildStampFile)" Lines="$(BuildTimestamp)" Overwrite="true" />
    <Message Text="[BuildStamp] $(AssemblyName) (stamp=$(_BuildStampFile))" Importance="High" />
  </Target>

  <!-- Release: tên chuẩn MCG_* theo MCGVN Installation Guide -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <AssemblyName>MCG_LashingHole</AssemblyName>
  </PropertyGroup>

  <!-- Auto-detect AutoCAD installation path — chỉ 2025+ (build .NET 8) -->
  <PropertyGroup>
    <AcadPath Condition="Exists('C:\Program Files\Autodesk\AutoCAD 2026')">C:\Program Files\Autodesk\AutoCAD 2026</AcadPath>
    <AcadPath Condition="'$(AcadPath)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2025')">C:\Program Files\Autodesk\AutoCAD 2025</AcadPath>
    <AcadPath Condition="'$(AcadPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AcadPath>
  </PropertyGroup>

  <!-- References AutoCAD API trực tiếp từ máy (không cần NuGet restore) -->
  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- WPF & WinForms: đã có sẵn qua UseWPF / UseWindowsForms (net8 WindowsDesktop) -->

  <!-- Log tên DLL sau mỗi lần build -->
  <Target Name="WriteBuildInfo" AfterTargets="Build">
    <Message Text="[Build OK] $(AssemblyName).dll → $(OutputPath)" Importance="High" />
  </Target>

  <!-- Release: deploy NGUYÊN thư mục output (DLL + .deps.json + .runtimeconfig.json)
       vào C:\CustomTools\Autocad\MCG_LashingHole\ — Install_AutoLoadCadAddin.bat
       đóng gói thành bundle .NET 8. -->
  <Target Name="DeployToCustomTools" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <_Deploy Include="$(OutputPath)**\*" />
    </ItemGroup>
    <RemoveDir Directories="C:\CustomTools\Autocad\MCG_LashingHole" />
    <MakeDir Directories="C:\CustomTools\Autocad\MCG_LashingHole" />
    <Copy SourceFiles="@(_Deploy)"
          DestinationFiles="@(_Deploy-&gt;'C:\CustomTools\Autocad\MCG_LashingHole\%(RecursiveDir)%(Filename)%(Extension)')"
          ContinueOnError="true" />
    <Message Text="[Deploy] MCG_LashingHole (net8, full folder) → C:\CustomTools\Autocad\MCG_LashingHole" Importance="High" />
  </Target>

</Project>
