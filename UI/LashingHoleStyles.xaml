<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Light theme — đồng bộ với MCG_FittingManagement/FittingStyles.xaml
         ============================================================ -->

    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#FF222222"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="8,6,8,8"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="#FFE1E1E1"/>
        <Setter Property="Foreground" Value="#FF111111"/>
        <Setter Property="BorderBrush" Value="#FFADADAD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFD0D0D0"/>
                <Setter Property="BorderBrush" Value="#FF999999"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFBDBDBD"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CTA chính — nút START -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FF005E9E"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="BorderBrush" Value="#FF004C82"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF004C82"/>
                <Setter Property="BorderBrush" Value="#FF003A63"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF003A63"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Nút nằm ngang trên toolbar (WrapPanel) — copy nguyên từ FittingStyles.xaml để
         Start/Batch/Audit/Audit Interference có đúng hình hài nút Add/Scan/Insert của ref:
         gọn, MinWidth cố định, không full-width, không set Margin đáy của Button dọc mặc định. -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="MinWidth" Value="70"/>
    </Style>

    <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="MinWidth" Value="70"/>
    </Style>

    <!-- Label cột trái trong grid Input Parameters -->
    <Style x:Key="LblStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF444444"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Chú thích nhỏ dưới nút Start/Batch -->
    <Style x:Key="HelperTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF666666"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- Status label cuối palette -->
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF005E9E"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

</ResourceDictionary>
