<UserControl x:Class="SDS.UI.InfoPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D2D">
    <ScrollViewer>
        <StackPanel Margin="10">
            <Button Content="PICK OBJECT"
                    Click="PickBtn_Click"
                    Height="35"
                    Background="#007ACC"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Border Background="#3E3E42"
                    Margin="0,10,0,0"
                    Padding="10"
                    CornerRadius="4">
                <StackPanel Name="InfoPanel">
                    <TextBlock Text="ĐỐI TƯỢNG ĐÃ CHỌN"
                               Foreground="#F1F1F1"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <ItemsControl Name="LstProperties">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}"
                                               Foreground="#9CDCFE"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               Foreground="#DCDCDC"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>