<UserControl x:Class="SDS.UI.LashingHolePalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Width="360">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">

            <!-- Title -->
            <TextBlock Text="LASHING HOLE GENERATOR"
                       Foreground="#90CDF4" FontWeight="Bold" FontSize="13"
                       Margin="0,4,0,14"/>

            <!-- ── Thông số lỗ ── -->
            <TextBlock Text="Thông số lỗ" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Panel Name:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPanelName" Grid.Column="1" Text="PNL_01"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2"/>

                <TextBlock Grid.Row="1" Text="Hole Diameter (D):" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox x:Name="txtHoleDiameter" Grid.Row="1" Grid.Column="1" Text="55"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2"/>

                <TextBlock Grid.Row="2" Text="Clearance Radius:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox x:Name="txtClearance" Grid.Row="2" Grid.Column="1" Text="75"
                         Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2"/>

                <TextBlock Grid.Row="3" Text="Offset X / Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtOffsetX" Width="62" Text="150"
                             Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2,4,2"/>
                    <TextBox x:Name="txtOffsetY" Width="62" Text="150"
                             Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Spacing X / Y:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtSpacingX" Width="62" Text="500"
                             Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2,4,2"/>
                    <TextBox x:Name="txtSpacingY" Width="62" Text="500"
                             Background="#2D2D2D" Foreground="White" BorderBrush="#555" Padding="4,2" Margin="0,2"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Text="Location Mode:" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbLocationMode" Grid.Row="5" Grid.Column="1"
                          Background="#2D2D2D" Foreground="White" BorderBrush="#555"
                          Margin="0,2" SelectedIndex="0">
                    <ComboBoxItem Content="PortSide (Dưới-Trái)"/>
                    <ComboBoxItem Content="StarBoard (Trên-Trái)"/>
                    <ComboBoxItem Content="Center (Đối xứng tâm)"/>
                </ComboBox>
            </Grid>

            <!-- ── Tuỳ chọn ── -->
            <CheckBox x:Name="chkAutomatic" Content="Automatic Generate" Foreground="White" Margin="0,0,0,6"/>
            <CheckBox x:Name="chkCheckAdjacent" Content="Check Adjacent Panel" Foreground="White" Margin="0,0,0,14"/>

            <!-- ── Chọn đối tượng ── -->
            <TextBlock Text="Chọn đối tượng" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>

            <Button x:Name="cmdPickBoundary" Content="1.  Pick Boundary Polyline"
                    Click="CmdPickBoundary_Click"
                    Background="#1A3A10" Foreground="White" Height="30" Margin="0,0,0,4"
                    BorderBrush="#4CAF50" BorderThickness="1"/>
            <TextBlock x:Name="lblBoundary" Text="— chưa chọn —"
                       Foreground="#666" FontSize="10" Margin="4,0,0,10"/>

            <Button x:Name="cmdPickStructures" Content="2.  Pick Structural Elements"
                    Click="CmdPickStructures_Click"
                    Background="#10253A" Foreground="White" Height="30" Margin="0,0,0,4"
                    BorderBrush="#2196F3" BorderThickness="1"/>
            <TextBlock x:Name="lblStructures" Text="— chưa chọn —"
                       Foreground="#666" FontSize="10" Margin="4,0,0,14"/>

            <!-- ── Tạo lỗ ── -->
            <Button x:Name="cmdCreate" Content="CREATE LASHING HOLES"
                    Click="CmdCreate_Click"
                    Background="#1A4A8A" Foreground="White" Height="38"
                    FontWeight="Bold" FontSize="13" BorderBrush="#2196F3" BorderThickness="1"
                    Margin="0,0,0,14"/>

            <!-- ── Phase 3 ── -->
            <Separator Background="#3A3A3A" Margin="0,0,0,10"/>
            <TextBlock Text="Phase 3 — Khu vực đặc biệt" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#666" Margin="0,0,0,6">
                Chọn 2 hole hiện có → điền holes trung gian vào khoảng trống.
            </TextBlock>
            <Button x:Name="cmdPhase3" Content="Pick 2 Holes  →  Regenerate Area"
                    Click="CmdPhase3_Click"
                    Background="#3A1A0A" Foreground="White" Height="30"
                    BorderBrush="#FF6030" BorderThickness="1" Margin="0,0,0,14"/>

            <!-- ── Trạng thái ── -->
            <Separator Background="#3A3A3A" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblStatus" Text="" Foreground="#90CDF4"
                       FontSize="11" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
