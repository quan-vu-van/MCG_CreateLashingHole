<UserControl x:Class="MCG_CreateLashingHole.UI.LashingHolePalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Width="370"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <!-- Shared styles cho TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="#2D2D2D"/>
            <Setter Property="Foreground"   Value="#EEEEEE"/>
            <Setter Property="BorderBrush"  Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Shared styles cho Label -->
        <Style TargetType="TextBlock" x:Key="LblStyle">
            <Setter Property="Foreground"  Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <!-- Section header -->
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground"  Value="#5599CC"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,4,0,4"/>
        </Style>
        <!-- RadioButton style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"  Value="#CCCCCC"/>
            <Setter Property="Margin"      Value="0,2,0,2"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <!-- CheckBox style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#CCCCCC"/>
            <Setter Property="Margin"      Value="0,3,0,3"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>
        <!-- Separator style -->
        <Style TargetType="Separator">
            <Setter Property="Background"  Value="#383838"/>
            <Setter Property="Margin"      Value="0,6,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,14">

            <!-- ══ TITLE ══ -->
            <TextBlock Text="LASHING HOLE GENERATOR"
                       Foreground="#90CDF4" FontWeight="Bold" FontSize="13"
                       Margin="0,0,0,10"/>

            <!-- ══ INPUT PARAMETERS ══ -->
            <TextBlock Text="INPUT PARAMETERS" Style="{StaticResource SectionHeader}"/>
            <Border BorderBrush="#333" BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <!-- Panel Name -->
                <TextBlock Grid.Row="0" Text="Panel Name:" Style="{StaticResource LblStyle}"/>
                <TextBox   x:Name="txtPanelName" Grid.Row="0" Grid.Column="1" Text="PNL_01" Margin="0,2"/>

                <!-- Hole Diameter -->
                <TextBlock Grid.Row="1" Text="Hole Diameter D (mm):" Style="{StaticResource LblStyle}" TextWrapping="Wrap"/>
                <TextBox   x:Name="txtHoleDiameter" Grid.Row="1" Grid.Column="1" Text="55" Margin="0,2"/>

                <!-- Clearance Radius -->
                <TextBlock Grid.Row="2" Text="Clearance Radius (mm):" Style="{StaticResource LblStyle}" TextWrapping="Wrap"/>
                <TextBox   x:Name="txtClearance" Grid.Row="2" Grid.Column="1" Text="75" Margin="0,2"/>

                <!-- Offset -->
                <TextBlock Grid.Row="3" Text="Offset X / Y (mm):" Style="{StaticResource LblStyle}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtOffsetX" Width="62" Text="150" Margin="0,2,4,2"/>
                    <TextBox x:Name="txtOffsetY" Width="62" Text="150" Margin="0,2"/>
                </StackPanel>

                <!-- Spacing -->
                <TextBlock Grid.Row="4" Text="Spacing X / Y (mm):" Style="{StaticResource LblStyle}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtSpacingX" Width="62" Text="500" Margin="0,2,4,2"/>
                    <TextBox x:Name="txtSpacingY" Width="62" Text="500" Margin="0,2"/>
                </StackPanel>
            </Grid>

            <Separator/>

            <!-- ══ EXECUTION MODES (RadioButtons — khớp VBA Option Buttons) ══ -->
            <TextBlock Text="EXECUTION MODE" Style="{StaticResource SectionHeader}"/>

            <RadioButton x:Name="rbPortSide" GroupName="LocationMode" IsChecked="True"
                         Content="P: PortSide    P1 = Lower-Left → P2 = Upper-Right"
                         Margin="4,2,0,2"/>
            <RadioButton x:Name="rbStarBoard" GroupName="LocationMode"
                         Content="S: StarBoard   P1 = Upper-Left → P2 = Lower-Right"
                         Margin="4,2,0,2"/>
            <RadioButton x:Name="rbCenter"    GroupName="LocationMode"
                         Content="C: Center       Symmetric from geometric centroid"
                         Margin="4,2,0,2"/>

            <Separator/>

            <!-- ══ SETTINGS ══ -->
            <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}"/>

            <CheckBox x:Name="chkAutomatic"     Content="Automatic Generate (auto-detect boundary + structures)"
                      Margin="4,3,0,3"/>
            <CheckBox x:Name="chkCheckAdjacent" Content="Check Adjacent Panels (keep-out zones)"
                      Margin="4,3,0,3"/>

            <Separator/>

            <!-- ══ PREPARATION ══ -->
            <TextBlock Text="PREPARATION" Style="{StaticResource SectionHeader}"/>

            <!-- Pick Boundary — không hiển thị nếu Automatic được chọn -->
            <Button x:Name="cmdPickBoundary" Content="1.  Select Boundary Polyline"
                    Click="CmdPickBoundary_Click"
                    Background="#1A3A10" Foreground="White" Height="28"
                    BorderBrush="#4CAF50" BorderThickness="1" Margin="0,0,0,3"/>
            <TextBlock x:Name="lblBoundary" Text="— not selected —"
                       Foreground="#666" FontSize="10" Margin="4,0,0,8"/>

            <Button x:Name="cmdPickStructures" Content="2.  Select Structural Elements"
                    Click="CmdPickStructures_Click"
                    Background="#0F2535" Foreground="White" Height="28"
                    BorderBrush="#2196F3" BorderThickness="1" Margin="0,0,0,3"/>
            <TextBlock x:Name="lblStructures" Text="— not selected —"
                       Foreground="#666" FontSize="10" Margin="4,0,0,8"/>

            <!-- ══ MAIN ACTION ══ -->
            <Button x:Name="cmdCreate" Content="CREATE LASHING HOLES"
                    Click="CmdCreate_Click"
                    Background="#1A4A8A" Foreground="White" Height="36"
                    FontWeight="Bold" FontSize="13"
                    BorderBrush="#2196F3" BorderThickness="1" Margin="0,2,0,10"/>

            <Separator/>

            <!-- ══ PHASE 2 — SPECIAL AREA ══ -->
            <TextBlock Text="PHASE 2 — SPECIAL AREA" Style="{StaticResource SectionHeader}"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#888888" Margin="0,0,0,5">
                Select 2 existing holes → fill intermediate holes in the gap.
            </TextBlock>
            <Button x:Name="cmdPhase2" Content="Pick 2 Holes  →  Fill Gap"
                    Click="CmdPhase2_Click"
                    Background="#3A1A0A" Foreground="White" Height="28"
                    BorderBrush="#FF6030" BorderThickness="1" Margin="0,0,0,8"/>

            <Separator/>

            <!-- ══ AUDIT ══ -->
            <TextBlock Text="AUDIT" Style="{StaticResource SectionHeader}"/>
            <Button x:Name="cmdAudit" Content="Audit Holes in Boundary"
                    Click="CmdAudit_Click"
                    Background="#2A1A3A" Foreground="White" Height="28"
                    BorderBrush="#9C6FCC" BorderThickness="1" Margin="0,0,0,8"/>

            <Separator/>

            <!-- ══ STATUS ══ -->
            <TextBlock x:Name="lblStatus" Text="Ready."
                       Foreground="#90CDF4" FontSize="11" TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
