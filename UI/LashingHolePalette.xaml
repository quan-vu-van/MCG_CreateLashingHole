<UserControl x:Class="MCG_CreateLashingHole.UI.LashingHolePalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF2F2F2" Width="370"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LashingHoleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- RadioButton / CheckBox: chỉ chỉnh FontSize, giữ màu chữ mặc định (đen trên nền sáng) -->
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,3,0,3"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,14">

            <!-- ══ TITLE ══ -->
            <TextBlock Text="LASHING HOLE GENERATOR"
                       Foreground="#FF222222" FontWeight="Bold" FontSize="13"
                       Margin="0,0,0,10"/>

            <!-- ══ INPUT PARAMETERS ══ -->
            <GroupBox Header="Input Parameters">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Name -->
                    <TextBlock Grid.Row="0" Text="Panel Name:" Style="{StaticResource LblStyle}"/>
                    <TextBox   x:Name="txtPanelName" Grid.Row="0" Grid.Column="1" Text="PNL_01" Margin="0,2"/>

                    <!-- Hole Diameter -->
                    <TextBlock Grid.Row="1" Text="Hole Diameter D (mm):" Style="{StaticResource LblStyle}" TextWrapping="Wrap"/>
                    <TextBox   x:Name="txtHoleDiameter" Grid.Row="1" Grid.Column="1" Text="55" Margin="0,2"/>

                    <!-- Clearance Radius -->
                    <TextBlock Grid.Row="2" Text="Clearance Radius (mm):" Style="{StaticResource LblStyle}" TextWrapping="Wrap"/>
                    <TextBox   x:Name="txtClearance" Grid.Row="2" Grid.Column="1" Text="75" Margin="0,2"/>

                    <!-- Offset -->
                    <TextBlock Grid.Row="3" Text="Offset X / Y (mm):" Style="{StaticResource LblStyle}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtOffsetX" Width="62" Text="150" Margin="0,2,4,2"/>
                        <TextBox x:Name="txtOffsetY" Width="62" Text="150" Margin="0,2"/>
                    </StackPanel>

                    <!-- Spacing -->
                    <TextBlock Grid.Row="4" Text="Spacing X / Y (mm):" Style="{StaticResource LblStyle}"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="txtSpacingX" Width="62" Text="500" Margin="0,2,4,2"/>
                        <TextBox x:Name="txtSpacingY" Width="62" Text="500" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ══ EXECUTION MODE (khớp VBA Option Buttons) ══ -->
            <GroupBox Header="Execution Mode">
                <StackPanel>
                    <RadioButton x:Name="rbPortSide" GroupName="LocationMode" IsChecked="True"
                                 Content="P: PortSide    P1 = Lower-Left → P2 = Upper-Right"
                                 Margin="4,2,0,2"/>
                    <RadioButton x:Name="rbStarBoard" GroupName="LocationMode"
                                 Content="S: StarBoard   P1 = Upper-Left → P2 = Lower-Right"
                                 Margin="4,2,0,2"/>
                    <RadioButton x:Name="rbCenter"    GroupName="LocationMode"
                                 Content="C: Center       Symmetric from geometric centroid"
                                 Margin="4,2,0,2"/>
                </StackPanel>
            </GroupBox>

            <!-- ══ SETTINGS ══ -->
            <GroupBox Header="Settings">
                <StackPanel>
                    <CheckBox x:Name="chkAutomatic"
                              Content="Automatic Generate (auto P1-P2, start at Center)"
                              Margin="4,3,0,3"/>
                    <CheckBox x:Name="chkCheckAdjacent"
                              Content="Check Adjacent Panels (keep-out zones)"
                              Margin="4,3,0,3"/>
                </StackPanel>
            </GroupBox>

            <!-- ══ RUN — toolbar gọn giống nút Add/Scan/Insert của ref. Mô tả dài đưa vào
                 ToolTip thay vì caption riêng dưới mỗi nút. ══ -->
            <WrapPanel Margin="1,0,1,8">
                <Button x:Name="cmdStart" Content="▶  Start"
                        Click="CmdStart_Click"
                        Style="{StaticResource ToolbarPrimaryButtonStyle}"
                        ToolTip="Run the generator with current parameters. All steps run on the command line after Start."/>
                <Button x:Name="cmdBatch" Content="▶▶  Batch"
                        Click="CmdBatch_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Multi-panel, Automatic mode only. Select each boundary + assign P/C/S."/>
            </WrapPanel>

            <!-- ══ AUDIT ══ -->
            <GroupBox Header="Audit">
                <WrapPanel>
                    <Button x:Name="cmdAudit" Content="Audit Holes"
                            Click="CmdAudit_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Audit holes in boundary (spacing report)"/>
                    <Button x:Name="cmdAuditInterference" Content="Audit Interference"
                            Click="CmdAuditInterference_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Audit interference (cloud marks)"/>
                </WrapPanel>
            </GroupBox>

            <!-- ══ STATUS ══ -->
            <TextBlock x:Name="lblStatus" Text="Ready."
                       Style="{StaticResource StatusTextStyle}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
